# ============ 服务 ============
PORT=3000
DATA_DIR=data
LOG_DIR=logs
# 请求体上限（字节）。OCS 5.x 会把图片题转成 base64 直传，几 MB 很正常
MAX_BODY_BYTES=16777216

# ============ 第一步：先只捕获，不答题 ============
# 打开后会把 OCS 发来的**原始报文**逐条落盘到 data/capture.jsonl。
# 建议先用捕获模式跑一段时间，看清 OCS 到底发什么，再开作答。
CAPTURE_ENABLED=true
CAPTURE_FILE=capture.jsonl
# 是否连 headers 一起记（排查跨域/探测问题时有用）
CAPTURE_HEADERS=true

# 作答总开关。false = 只记录并返回 code:0（OCS 显示"搜不到"），不花 token。
SOLVE_ENABLED=false

# ============ 大模型（任何兼容 OpenAI /chat/completions 的端点）============
# 选 deepseek-flash：原生多模态，能把 OCS 塞进题干的图片一起看（见下面"图片题"一节）
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-flash
# 思考等级 low|high|max。**不传时接口默认 high**，对"每题都要跑完"的服务偏慢，建议 low。
# 实测 deepseek-flash 与 deepseek-v4-pro 都支持这三档。
# 注意：deepseek-flash 支持图片输入（text+image），deepseek-v4-pro 只支持文本。
AI_EFFORT=low
AI_TIMEOUT_MS=120000
# 空闲超时：流式下连续这么久收不到任何数据才判失败（比等满整请求上限更早发现问题）
AI_IDLE_TIMEOUT_MS=30000
AI_TEMPERATURE=0
ENABLE_JSON_MODE=true
AI_MAX_RETRY=1
# 流式请求：终端能边收边显示"思考"与逐项判断。关掉则退回一次性返回。
# 即使开着，端点若忽略 stream 标志返回普通 JSON，也会自动按一次性响应处理。
AI_STREAM=true
# 上游 429/5xx/网络抖动的额外重试次数（与上面的"JSON 解析失败重试"是两回事）
AI_MAX_NETWORK_RETRY=2
# 重试退避基数：第 n 次等待 base * 2^(n-1) + 随机抖动
AI_RETRY_BASE_MS=1500

# ============ 图片题（OCS 5.x 原生图片优化）============
# OCS 5.2.1 会把题干/选项里的图片转成 base64 直传（并顺带做了防盗链绕过、PNG 放大、会话缓存），
# 前提是题库配置里显式声明了 ${images} / ${suggestion_title} / ${suggestion_options}，
# 且 method 为 post（见 ocs-config.json）。
# 本服务优先用这份 base64；收不到时才退回从题干的 img.src 猜（会撞防盗链）。
SEND_IMAGES=true
# 单题最多附带几张图，防止 token 爆炸
MAX_IMAGES=4

# ============ 回写策略（详见 docs/OCS-CONTRACT.md 第五节）============
# text = 回选项原文（推荐，走 OCS 的阶段1/2 文本匹配）；letter = 回字母（阶段3 兜底）
EMIT_MODE=text
# 回写前用从 OCS 源码移植来的匹配算法自检，不通过则自动降级
EMIT_VERIFY=true

# ============ 终端界面 ============
# 每题一张卡片（题干+选项），下方流式显示思考与逐项判断，末尾一行结论。
#
# auto（默认）：是终端且 TERM!=dumb 才用富界面；否则退回纯文本。
#   —— 也就是说管道、日志、CI 环境下输出与"加 UI 之前"逐字节一致，不影响现有用法。
# rich：强制富界面（管道里预览效果用）
# plain：强制纯文本（等价于关掉这套界面）
UI_STYLE=auto
# auto | always | never。遵循 NO_COLOR 约定，非 TTY 自动关闭。
UI_COLOR=auto
# 卡片总宽。0 = 按终端宽度自动（会被钳到 44..100）
UI_WIDTH=0

# 想直接看效果（不需要 OCS、不需要 API Key）：
#   npm run demo
#   npm run demo -- --plain      # 看纯文本样子
#   npm run demo -- --rich --nocolor   # 在管道里看富界面布局
