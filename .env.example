# ============ AI 接口配置（默认 DeepSeek） ============
# 填写你的 api key
AI_API_KEY=sk-*******
AI_API_URL=https://api.deepseek.com/v1/chat/completions
# 模型名：deepseek-chat（快）｜deepseek-reasoner（思考模式，细节题更准但更慢）
AI_MODEL=deepseek-chat

# ============ 服务端口 ============
PORT=3000

# ============ 答题行为 ============
# 课程语境，会写进提示词，让模型以教材/官方表述为准
COURSE_CONTEXT=中国近现代史纲要
# 单次调用超时（毫秒）。reasoner 建议 60000
AI_TIMEOUT_MS=30000
# 采样温度，0 最稳
AI_TEMPERATURE=0
# 强制模型输出 json（接口不支持时会自动降级）
ENABLE_JSON_MODE=true
# JSON 解析失败后的重试次数（仅失败时才多花 token）
AI_MAX_RETRY=1
# 自洽投票票数：1 = 关闭（默认零额外成本）；3 = 问 3 次取多数（token ×3，更准）
SELF_CONSISTENCY_N=1
# 投票时非首票的采样温度
VOTE_TEMPERATURE=0.7

# 返回给 OCS 的答案形态：auto = 单选/多选返回字母、判断题返回选项原文
ANSWER_FORMAT=auto
# 模型完全给不出答案时：none = code:0 交给 OCS 报“搜索不到”（不瞎选）；first = 兜底选 A
FALLBACK_ON_EMPTY=none
# 多选答案分隔符，必须是 OCS splitAnswer 认得的符号
MULTI_SEPARATOR=#

# ============ 缓存与纠错 ============
CACHE_ENABLED=true
CACHE_TTL_DAYS=30

# ============ 联网检索（免 API Key，默认关闭） ============
# 打开后会增加提示词长度（更多 token），但能兜住模型没学过的专业课细节
ENABLE_WEB_SEARCH=false
# off = 从不检索｜smart = 只在含年份/书名号/会议条约等“需要查证”的题上检索｜always = 每题都检索
SEARCH_MODE=smart
SEARCH_TIMEOUT_MS=3000
# 整个检索阶段的总预算（毫秒），超时就用已有资料继续答题
SEARCH_TOTAL_BUDGET_MS=6000
SEARCH_MAX_CHARS=1200
SEARCH_MAX_RESULTS=4
